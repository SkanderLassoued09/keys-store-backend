# Backend — PRODUCTION
# Loaded automatically by src/load-env.ts when NODE_ENV=production
# (i.e. via `npm run start:prod`). Host binding (0.0.0.0 = reachable on the LAN,
# e.g. 192.168.x.x) is derived from NODE_ENV in main.ts, so it is NOT set here.

PORT=3000

# MongoDB. If prod runs on the host machine, point at the Docker Mongo published
# on 27018 (below). If prod runs INSIDE the Docker compose network instead, use:
#   mongodb://admin:admin@mongodb:27017/keysstore?authSource=keysstore
MONGO_URI=mongodb://admin:admin@127.0.0.1:27018/keysstore?authSource=keysstore

# CHANGE THIS to a long random string before real use.
JWT_SECRET=replace-with-a-long-random-secret

# Seeded owner password (only used the first time, on an empty user collection).
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

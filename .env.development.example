# Backend — DEVELOPMENT
# Loaded automatically by src/load-env.ts when NODE_ENV=development
# (i.e. via `npm run start:dev`). Host binding (127.0.0.1 = local only) is
# derived from NODE_ENV in main.ts, so it is NOT set here.

PORT=3000

# Local MongoDB. Default points at the Docker Mongo published on host port 27018.
# Adjust if your local Mongo differs (e.g. 127.0.0.1:27017).
MONGO_URI=mongodb://admin:admin@127.0.0.1:27018/keysstore?authSource=keysstore

# Dev-only secret. Fine to be weak locally.
JWT_SECRET=your-dev-secret

# Seeded owner password (only used the first time, on an empty user collection).
DEFAULT_ADMIN_PASSWORD=admin123
